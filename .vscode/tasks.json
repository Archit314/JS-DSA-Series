{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run JS with IO (Universal)",
            "type": "shell",
            "command": "node \"${file}\" < \"${fileDirname}/input.txt\" > \"${fileDirname}/output.txt\"",
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "node \"${file}\" < \"${fileDirname}\\input.txt\" > \"${fileDirname}\\output.txt\"",
                "options": {
                    "shell": {
                        "executable": "C:\\Windows\\System32\\cmd.exe",
                        "args": ["/c"]
                    }
                }
            },
            "linux": {
                "command": "node \"${file}\" < \"${fileDirname}/input.txt\" > \"${fileDirname}/output.txt\"",
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            }
        }
    ]
}